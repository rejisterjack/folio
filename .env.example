# Pooled connection string. On Neon, use the host that contains "-pooler".
DATABASE_URL="postgresql://user:password@localhost:5432/folio"

# Direct connection string for migrations. On Neon, use the host without "-pooler".
DIRECT_URL="postgresql://user:password@localhost:5432/folio"

# Long random string for sessions and API key hashing.
# Generate one with: openssl rand -base64 32
AUTH_SECRET="replace-with-a-long-random-string"
